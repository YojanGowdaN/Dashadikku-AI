# ═══════════════════════════════════════════════════════════════
# DASHADIKKU AI — Environment Variables Reference
# ═══════════════════════════════════════════════════════════════
#
# This file documents all configuration variables for main.html.
# Browsers cannot read .env files directly.
#
# ► HOW TO USE:
#   1. Copy your values into  frontend/env.js
#   2. Open main.html in any browser — it loads env.js automatically
#
# ═══════════════════════════════════════════════════════════════

# ── AI API KEYS ──────────────────────────────────────────────────
# Gemini  → Get free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Claude  → Get at: https://console.anthropic.com/
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# ── AI MODELS ────────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.0-flash
GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation
CLAUDE_MODEL=claude-opus-4-5

# ── API BASE URLS ─────────────────────────────────────────────────
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ── USAGE LIMIT ───────────────────────────────────────────────────
# Number of free messages before the payment wall appears.
# Set to 0 for unlimited.
FREE_MESSAGE_LIMIT=10

# ── ADS ───────────────────────────────────────────────────────────
SHOW_ADS=true
AD_EVERY_N=3

# ── PAYMENT LINKS ─────────────────────────────────────────────────
# Replace with your Stripe / payment processor URLs
PRO_PAYMENT_LINK=YOUR_PRO_PAYMENT_LINK
ENTERPRISE_PAYMENT_LINK=YOUR_ENTERPRISE_PAYMENT_LINK
